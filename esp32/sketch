void setup() {
  Serial.begin(115200);
  delay(1000);

  // configuracao do Motor
  motor.setMaxSpeed(1000);
  motor.setSpeed(velocidade);
  motor.disableOutputs();

  // TLS e MQTT
  espClient.setCACert(root_ca);

  mqttClient.setServer(MQTT_BROKER, MQTT_PORT);
  mqttClient.setCallback(mensagemRecebida);
  mqttClient.setKeepAlive(30);
  mqttClient.setSocketTimeout(10);
  mqttClient.setBufferSize(2048);

  // confg do wifi
  WiFi.mode(WIFI_STA);
  WiFi.setAutoReconnect(true);

  //conexoes de rede e hora
  conectarWiFi();
  setupNTP();

  carregarAgendamentosDoFlash();

  Serial.println("ESP32 iniciado!");
}

void loop() {
  //cerifica e tenta recuperar a conexao
  conectarWiFi();

  static bool wifiAnterior = false;
  bool wifiAtual = (WiFi.status() == WL_CONNECTED);

  if (wifiAtual && !wifiAnterior) {
    Serial.println("================================");
    Serial.println("WI-FI CONECTADO!");
    Serial.print("IP: ");
    Serial.println(WiFi.localIP());
    Serial.print("Sinal Wi-Fi (RSSI): ");
    Serial.println(WiFi.RSSI());
    Serial.println("================================");
  }

  if (!wifiAtual && wifiAnterior) {
    Serial.println("Wi-Fi desconectado!");
  }

  wifiAnterior = wifiAtual;

  //gerencia o mqtt somente quando o wifi tiver conectado
  if (motorLigado) {
    motor.runSpeed();

    if (millis() - inicioMotor >= tempoMotor) {
      motorLigado = false;
      motor.disableOutputs();

      Serial.println("\n================================");
      Serial.println("Tempo terminado. Motor parado.");
      Serial.println("================================");

      publicarStatus("finalizado");
    }
  }

  //verifica a hora
  verificarAgendamentosLocais();

  //gerenciar o mqtt o wifi tiver conectado
  if (WiFi.status() == WL_CONNECTED) {

  //nao tentar uma nova conexão com o acionamento do motor
  if (!mqttClient.connected() && !motorLigado) {
    conectarMQTT();
  }
  // manter conexao mqtt quando tiver conectado
  if (mqttClient.connected()) {
    mqttClient.loop();
  }

  } else {
    if (mqttClient.connected()) {
      mqttClient.disconnect();
    }
  }
}

// REDE E NTP PROTOCOLO DE TEMPO
void conectarWiFi() {
 //se tiver conectado não precisa tentar novamente
  if (WiFi.status() == WL_CONNECTED) {
    return;
  }

  unsigned long agora = millis();

  //aguarda intervalo entre as tentativas
  if (!primeiraTentativaWiFi &&
      agora - ultimaTentativaWiFi < INTERVALO_WIFI) {
    return;
  }

  primeiraTentativaWiFi = false;
  ultimaTentativaWiFi = agora;

  Serial.println("Iniciando conexão com o Wi-Fi...");

  WiFi.begin(WIFI_SSID, WIFI_PASSWORD);
}


