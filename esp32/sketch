#include <WiFi.h>
#include <PubSubClient.h>
#include <AccelStepper.h>
#include <WiFiClientSecure.h>
#include <Preferences.h>
#include <ArduinoJson.h>
#include "time.h"

//CONFIGURACAO DO WIFI
const char* WIFI_SSID = "";
const char* WIFI_PASSWORD = "";



//HIVEMQ CLOUD CREDENCIAIS
const char* MQTT_BROKER = "";
const int MQTT_PORT = 8883;


const char* MQTT_USERNAME = "";
const char* MQTT_PASSWORD = "";

//TOPICOS MQTT
const char* MQTT_TOPIC_COMANDO      = "denys/alimentador/comando";
const char* MQTT_TOPIC_STATUS       = "denys/alimentador/status";
const char* MQTT_TOPIC_AGENDAMENTOS = "denys/alimentador/agendamentos";
const char* MQTT_TOPIC_SOLICITAR_AGENDAMENTOS = "denys/alimentador/agendamentos/solicitar";
const char* MQTT_TOPIC_RESPOSTA_AGENDAMENTOS = "denys/alimentador/agendamentos/resposta";
const char* MQTT_TOPIC_PRESENCA = "denys/alimentador/presenca";


//CERTIFICADO TLS 
static const char root_ca[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----

-----END CERTIFICATE-----
)EOF";

AccelStepper motor(
 AccelStepper::FULL4WIRE,
 2,   // IN1
 5,   // IN3
 4,   // IN2
 13   // IN4
);


int velocidade = 500;
bool motorLigado = false;
unsigned long inicioMotor = 0;
unsigned long tempoMotor = 0;

// NTP fuso horaria brasilia
const char* NTP_SERVER      = "pool.ntp.org";
const long  GMT_OFFSET_SEC  = -3 * 3600;
const int   DAYLIGHT_OFFSET = 0;
int lastCheckedMinute       = -1;

//ESTRUTURA DE AGENDAMENTOS

struct FeedSchedule {
 int hour;
 int minute;
 int duration;
 bool enabled;
 char days[60];
};


#define MAX_SCHEDULES 15
FeedSchedule schedules[MAX_SCHEDULES];
int scheduleCount = 0;

Preferences preferences;
WiFiClientSecure espClient;
PubSubClient mqttClient(espClient);


// PROTOTIPOS
void conectarWiFi();
void setupNTP();
void conectarMQTT();
void publicarStatus(const char* status);
void mensagemRecebida(char* topic, byte* payload, unsigned int length);
void acionarMotorPorSegundos(unsigned long segundos);
void verificarAgendamentosLocais();
bool salvarAgendamentosNoFlash(const String& jsonPayload);
void carregarAgendamentosDoFlash();
void processarJSONAgendamentos(const String& jsonPayload);
void publicarAgendamentosDoFlash();

void setup() {
 Serial.begin(115200);
 delay(1000);

 // configuracao do Motor
 motor.setMaxSpeed(1000);
 motor.setSpeed(velocidade);
 motor.disableOutputs();


 // conexoes de Rede e Hora
 conectarWiFi();
 setupNTP();


 // TLS e MQTT
 espClient.setCACert(root_ca);
 mqttClient.setServer(MQTT_BROKER, MQTT_PORT);
 mqttClient.setCallback(mensagemRecebida);

 //intervalo de keepalive MQTT
  mqttClient.setKeepAlive(5);

//Carrega agendamentos gravados na memoria flash NVS
 carregarAgendamentosDoFlash();


 conectarMQTT();
}

void loop() {
 if (!mqttClient.connected()) {
   conectarMQTT();
 }
 mqttClient.loop();


 //controle domotor
 if (motorLigado) {
   motor.runSpeed();


   if (millis() - inicioMotor >= tempoMotor) {
     motorLigado = false;
     motor.disableOutputs();


     Serial.println("\n================================");
     Serial.println("Tempo terminado. Motor parado.");
     Serial.println("================================");


     publicarStatus("finalizado");
   }
 }


 //checagem de relogio para acionamento automatico
 verificarAgendamentosLocais();
}

// REDE E NTP PROTOCOLO DE TEMPO
void conectarWiFi() {
 Serial.print("Conectando ao Wi-Fi");
 WiFi.begin(WIFI_SSID, WIFI_PASSWORD);


 while (WiFi.status() != WL_CONNECTED) {
   delay(500);
   Serial.print(".");
 }


 Serial.println("\nWi-Fi conectado!");
 Serial.print("IP: ");
 Serial.println(WiFi.localIP());
}


void setupNTP() {
 configTime(GMT_OFFSET_SEC, DAYLIGHT_OFFSET, NTP_SERVER);
 struct tm timeinfo;
 Serial.print("Sincronizando relógio via NTP...");
 while (!getLocalTime(&timeinfo)) {
   Serial.print(".");
   delay(500);
 }
 Serial.println("\nHora certa sincronizada!");
}

//COMUNICACAO MQTT
void publicarStatus(const char* status) {
 if (mqttClient.connected()) {
   mqttClient.publish(MQTT_TOPIC_STATUS, status);
   Serial.print("Status enviado: ");
   Serial.println(status);
 }
}


void conectarMQTT() {
 while (!mqttClient.connected()) {
   Serial.println("\nConectando ao HiveMQ...");


   String clientId = "ESP32-Alimentador-" + String((uint32_t)ESP.getEfuseMac(), HEX);


   if (mqttClient.connect(clientId.c_str(), MQTT_USERNAME, MQTT_PASSWORD, MQTT_TOPIC_PRESENCA, 1, true, "offline")) {
     Serial.println("================================");
     Serial.println("MQTT CONECTADO COM TLS!");
     Serial.println("================================");

     //informa que o ESP32 esta online
     mqttClient.publish(MQTT_TOPIC_PRESENCA, "online", true);

     mqttClient.subscribe(MQTT_TOPIC_COMANDO);
     mqttClient.subscribe(MQTT_TOPIC_AGENDAMENTOS);
     mqttClient.subscribe(MQTT_TOPIC_SOLICITAR_AGENDAMENTOS);
    
     Serial.print("Inscrito em: ");
     Serial.println(MQTT_TOPIC_COMANDO);
     Serial.print("Inscrito em: ");
     Serial.println(MQTT_TOPIC_AGENDAMENTOS);
     Serial.print("Inscrito em: ");
     Serial.println(MQTT_TOPIC_SOLICITAR_AGENDAMENTOS);


     publicarStatus("online");
   } else {
     Serial.print("Falha MQTT, código: ");
     Serial.println(mqttClient.state());
     Serial.println("Tentando novamente em 5 segundos...");
     delay(5000);
   }
 }
}

void mensagemRecebida(char* topic, byte* payload, unsigned int length) {
  String mensagem = "";

  for (unsigned int i = 0; i < length; i++) {
    mensagem += (char)payload[i];
  }

  mensagem.trim();

  String topicoRecebido = String(topic);

  Serial.println("\n================================");
  Serial.print("Tópico: ");
  Serial.println(topicoRecebido);
  Serial.print("Conteúdo: ");
  Serial.println(mensagem);

  //TOPICO DE COMANDO MANUAL
  if (topicoRecebido == MQTT_TOPIC_COMANDO) {

    if (mensagem == "0") {
      motorLigado = false;
      motor.disableOutputs();

      Serial.println("Motor parado manualmente.");
      publicarStatus("parado");

    } else {
      unsigned long segundos = mensagem.toInt();

      if (segundos > 0) {
        acionarMotorPorSegundos(segundos);
      } else {
        Serial.println("Comando inválido.");
        publicarStatus("erro_comando");
      }
    }
  }

  //TOPICO DE LISTA DE AGENDAMENTOS
  else if (topicoRecebido == MQTT_TOPIC_AGENDAMENTOS) {

    Serial.println("Recebendo novos agendamentos...");

    if (!salvarAgendamentosNoFlash(mensagem)) {
      Serial.println("Agendamentos rejeitados. Lista anterior preservada.");
      return;
    }

    carregarAgendamentosDoFlash();

    Serial.println("Conferindo o que foi salvo na Flash:");
    publicarAgendamentosDoFlash();
  }

  //TOPICO DE SOLICITACAO DE AGENDAMENTOS
  else if (topicoRecebido == MQTT_TOPIC_SOLICITAR_AGENDAMENTOS) {

    Serial.println("Solicitação de agendamentos recebida.");

    publicarAgendamentosDoFlash();
  }

  Serial.println("================================");
}
 //TOPICO DE LISTA DE AGENDAMENTOS
 else if (String(topic) == MQTT_TOPIC_AGENDAMENTOS) {
  Serial.println("Recebendo novos agendamentos...");
   salvarAgendamentosNoFlash(mensagem);
   processarJSONAgendamentos(mensagem);

   Serial.println("Conferindo o que foi salvo na Flash:");
   publicarAgendamentosDoFlash();
 }

 else if (String(topic) == MQTT_TOPIC_AGENDAMENTOS) {
  Serial.println("Recebendo novos agendamentos...");

  if (!salvarAgendamentosNoFlash(mensagem)) {
    Serial.println("Agendamentos rejeitados. Lista anterior preservada.");
    return;
  }

  carregarAgendamentosDoFlash();

  Serial.println("Conferindo o que foi salvo na Flash:");
  publicarAgendamentosDoFlash();
}

 Serial.println("================================");
}


//ACIONA O MOTOR
void acionarMotorPorSegundos(unsigned long segundos) {
 tempoMotor = segundos * 1000UL;
 motorLigado = true;
 motor.enableOutputs();
 motor.setSpeed(velocidade);
 inicioMotor = millis();


 Serial.printf("Motor ligado por %lu segundos.\n", segundos);
 publicarStatus("alimentando");
}


//MEMORIA FLASH SINCRO AGENDAMENTOS

bool salvarAgendamentosNoFlash(const String& jsonPayload) {
  JsonDocument doc;

  DeserializationError error = deserializeJson(doc, jsonPayload);

  if (error || !doc.is<JsonArray>()) {
    Serial.println("ERRO: JSON de agendamentos inválido.");
    return false;
  }

  JsonArray array = doc.as<JsonArray>();

  if (array.size() > MAX_SCHEDULES) {
    Serial.println("ERRO: Limite de agendamentos excedido.");
    return false;
  }

  const char* diasValidos[] = {
    "mon", "tue", "wed", "thu", "fri", "sat", "sun"
  };

  for (JsonVariant item : array) {
    if (!item.is<JsonObject>()) {
      Serial.println("ERRO: Agendamento não é um objeto.");
      return false;
    }

    JsonObject obj = item.as<JsonObject>();

    String horario = obj["time"] | "";
    String dias = obj["days"] | "";

    int duracao = obj["portions"] | 0;

    if (
      horario.length() != 5 ||
      horario.charAt(2) != ':' ||
      !isDigit(horario.charAt(0)) ||
      !isDigit(horario.charAt(1)) ||
      !isDigit(horario.charAt(3)) ||
      !isDigit(horario.charAt(4))
    ) {
      Serial.println("ERRO: Horário inválido.");
      return false;
    }

    int hora = horario.substring(0, 2).toInt();
    int minuto = horario.substring(3, 5).toInt();

    if (hora > 23 || minuto > 59 || duracao < 1 || duracao > 60) {
      Serial.println("ERRO: Horário ou duração fora do limite.");
      return false;
    }

    if (dias.isEmpty()) {
      Serial.println("ERRO: Agendamento sem dias.");
      return false;
    }

    bool encontrouDia = false;

    for (const char* dia : diasValidos) {
      if (dias.indexOf(dia) >= 0) {
        encontrouDia = true;
        break;
      }
    }

    if (!encontrouDia) {
      Serial.println("ERRO: Dias inválidos.");
      return false;
    }
  }

  if (!preferences.begin("feeder", false)) {
    Serial.println("ERRO: Não foi possível abrir a NVS.");
    return false;
  }

  size_t gravados = preferences.putString("schedules", jsonPayload);
  preferences.end();

  if (gravados != jsonPayload.length()) {
    Serial.println("ERRO: Falha ao gravar agendamentos na NVS.");
    return false;
  }

  Serial.println("Agendamentos gravados na NVS com sucesso!");
  return true;
}


void carregarAgendamentosDoFlash() {
 preferences.begin("feeder", true);
 String json = preferences.getString("schedules", "[]");
 preferences.end();


 processarJSONAgendamentos(json);
 Serial.println("Agendamentos recarregados do Flash.");
}


void processarJSONAgendamentos(const String& jsonPayload) {
 StaticJsonDocument<2048> doc;
 DeserializationError error = deserializeJson(doc, jsonPayload);


 if (error) {
   Serial.print("Erro no JSON de agendamentos: ");
   Serial.println(error.c_str());
   return;
 }


 JsonArray array = doc.as<JsonArray>();
 scheduleCount = 0;


 for (JsonObject obj : array) {
   if (scheduleCount >= MAX_SCHEDULES) break;


   String timeStr = obj["time"] | "00:00";
   schedules[scheduleCount].hour = timeStr.substring(0, 2).toInt();
   schedules[scheduleCount].minute = timeStr.substring(3, 5).toInt();
   schedules[scheduleCount].duration = obj["portions"] | 5;
   schedules[scheduleCount].enabled = obj["enabled"] | true;


   String daysStr = obj["days"] | "";
  strncpy(
    schedules[scheduleCount].days,
    daysStr.c_str(),
    sizeof(schedules[scheduleCount].days) - 1
  );

schedules[scheduleCount].days[sizeof(schedules[scheduleCount].days) - 1] = '\0';


   scheduleCount++;
 }


 Serial.printf("Agendamentos carregados na memória RAM: %d\n", scheduleCount);
}

//CHECA HORARIO
void verificarAgendamentosLocais() {
 struct tm timeinfo;
 if (!getLocalTime(&timeinfo)) return;

 if (timeinfo.tm_min == lastCheckedMinute) return;
 lastCheckedMinute = timeinfo.tm_min;

 const char* wdayNames[] = {"sun", "mon", "tue", "wed", "thu", "fri", "sat"};
 String hojeNome = String(wdayNames[timeinfo.tm_wday]);


 for (int i = 0; i < scheduleCount; i++) {
   if (!schedules[i].enabled) continue;


   if (schedules[i].hour == timeinfo.tm_hour && schedules[i].minute == timeinfo.tm_min) {
     String diasStr = String(schedules[i].days);
     diasStr.toLowerCase(); // Garante tudo em minúsculo para evitar erros


     bool deveExecutar = false;
     if (diasStr.indexOf("todos os dias") != -1 || diasStr.indexOf(hojeNome) != -1) {
       deveExecutar = true;
     }


     if (deveExecutar) {
       Serial.printf("DISPARO AUTÔNOMO DE AGENDAMENTO: %02d:%02d!\n", schedules[i].hour, schedules[i].minute);
       acionarMotorPorSegundos(schedules[i].duration);
     }
   }
 }
}

void publicarAgendamentosDoFlash() {
  preferences.begin("feeder", true);
  String json = preferences.getString("schedules", "[]");
  preferences.end();

  Serial.println("Agendamentos lidos da Flash:");
  Serial.println(json);

  if (mqttClient.connected()) {
    bool enviado = mqttClient.publish(
      MQTT_TOPIC_RESPOSTA_AGENDAMENTOS,
      json.c_str()
    );

    Serial.println(
      enviado ? "Resposta enviada ao app."
              : "Falha ao enviar resposta."
    );
  }
}
