}


//MEMORIA FLASH SINCRO AGENDAMENTOS
bool validarAgendamentos(const String& jsonPayload) {
  JsonDocument doc;

  DeserializationError error = deserializeJson(doc, jsonPayload);

  if (error || !doc.is<JsonArray>()) {
    Serial.println("ERRO: JSON de agendamentos invalido.");
    return false;
  }

  JsonArray array = doc.as<JsonArray>();

  if (array.size() > MAX_SCHEDULES) {
    Serial.println("ERRO: Limite de agendamentos excedido.");
    return false;
  }

  const char* diasValidos[] = {
    "mon", "tue", "wed", "thu", "fri", "sat", "sun"
  };

  for (JsonVariant item : array) {
    if (!item.is<JsonObject>()) {
      Serial.println("ERRO: Agendamento nao e um objeto.");
      return false;
    }

    JsonObject obj = item.as<JsonObject>();

    if (!obj["time"].is<const char*>() ||
        !obj["portions"].is<int>() ||
        !obj["enabled"].is<bool>() ||
        !obj["days"].is<const char*>()) {
      Serial.println("ERRO: Campos ausentes ou invalidos.");
      return false;
    }

    String horario = obj["time"].as<String>();
    String dias = obj["days"].as<String>();
    int duracao = obj["portions"].as<int>();

    if (horario.length() != 5 ||
        horario.charAt(2) != ':' ||
        !isDigit(horario.charAt(0)) ||
        !isDigit(horario.charAt(1)) ||
        !isDigit(horario.charAt(3)) ||
        !isDigit(horario.charAt(4))) {
      Serial.println("ERRO: Horario invalido.");
      return false;
    }

    int hora = horario.substring(0, 2).toInt();
    int minuto = horario.substring(3, 5).toInt();

    if (hora > 23 || minuto > 59 ||
        duracao < 1 || duracao > 60) {
      Serial.println("ERRO: Horario ou duracao fora do limite.");
      return false;
    }

    if (dias.isEmpty()) {
      Serial.println("ERRO: Agendamento sem dias.");
      return false;
    }

    int inicio = 0;
    bool encontrouDia = false;

    while (inicio < dias.length()) {
      int separador = dias.indexOf(',', inicio);
      if (separador == -1) separador = dias.length();

      String dia = dias.substring(inicio, separador);
      dia.trim();

      bool valido = false;

      for (const char* diaValido : diasValidos) {
        if (dia == diaValido) {
          valido = true;
          break;
        }
      }

      if (!valido) {
        Serial.println("ERRO: Dia invalido: " + dia);
        return false;
      }

      encontrouDia = true;
      inicio = separador + 1;
    }

    if (!encontrouDia) {
      return false;
    }
  }

  return true;
}

bool migrarAgendamentosAntigos() {
  if (!preferences.begin("feeder", false)) {
    Serial.println("Erro ao abrir NVS para migracao.");
    return false;
  }

  //novo registro ja existe nao migrar novamente
  if (preferences.isKey("schedule_v2")) {
    preferences.end();
    return true;
  }

  String jsonAntigo = preferences.getString("schedules", "[]");

  JsonDocument antigo;

  DeserializationError erro = deserializeJson(antigo, jsonAntigo);

  if (erro || !antigo.is<JsonArray>()) {
    Serial.println("Erro: agendamentos antigos invalidos.");
    preferences.end();
    return false;
  }

  JsonDocument novo;

  novo["revision"] = 0;
  novo["requestId"] = "";

  novo["feeds"] = antigo.as<JsonArray>();

  String registro;
  serializeJson(novo, registro);

  size_t gravados = preferences.putString("schedule_v2", registro);

  preferences.end();

  if (gravados != registro.length()) {
    Serial.println("Erro ao migrar agendamentos.");
    return false;
  }

  Serial.println("Agendamentos antigos migrados com sucesso!");
  return true;
}


bool salvarRegistroAgendamentos(
  const String& requestId,
  uint32_t revision,
  const String& feedsJSON
) {
  JsonDocument feedsDoc;

  DeserializationError erro = deserializeJson(feedsDoc, feedsJSON);

  if (erro || !feedsDoc.is<JsonArray>()) {
    Serial.println("Erro: lista de agendamentos invalida.");
    return false;
  }

  if (feedsDoc.as<JsonArray>().size() > MAX_SCHEDULES) {
    Serial.println("Erro: limite de agendamentos excedido.");
    return false;
  }

  JsonDocument registroDoc;

  registroDoc["revision"] = revision;
  registroDoc["requestId"] = requestId;
  registroDoc["feeds"] = feedsDoc.as<JsonArray>();

  String registroJSON;
  serializeJson(registroDoc, registroJSON);

  if (!preferences.begin("feeder", false)) {
    Serial.println("Erro ao abrir NVS.");
    return false;
  }

  if (registroJSON.length() > 1900) {
    Serial.println("ERRO: Registro excede o limite configurado.");
    preferences.end();
    return false;
  }

  size_t gravados = preferences.putString(
    "schedule_v2",
    registroJSON
  );

  preferences.end();

  if (gravados != registroJSON.length()) {
    Serial.println("Erro ao gravar registro na NVS.");
    return false;
  }

  //confirma que o registro pode ser lid novamente
  if (!preferences.begin("feeder", true)) {
    return false;
  }

  String registroLido = preferences.getString("schedule_v2", "");

  preferences.end();

  if (registroLido != registroJSON) {
    Serial.println("Erro: verificacao da gravacao falhou.");
    return false;
  }

  revisionAtual = revision;
  ultimoRequestId = requestId;

  Serial.printf(
    "Registro salvo na NVS! Revisao: %lu\n",
    (unsigned long)revisionAtual
  );

  return true;
}

bool migrarIdsAgendamentos() {
  if (!preferences.begin("feeder", false)) {
    Serial.println("Erro ao abrir NVS para migrar IDs.");
    return false;
  }

  String registro = preferences.getString("schedule_v2", "");

  JsonDocument doc;

  DeserializationError erro = deserializeJson(doc, registro);

  if (erro || !doc.is<JsonObject>() ||
      !doc["feeds"].is<JsonArray>()) {
    Serial.println("Erro ao interpretar agendamentos para migracao.");
    preferences.end();
    return false;
  }

  JsonArray feeds = doc["feeds"].as<JsonArray>();
  bool alterado = false;

  for (JsonObject feed : feeds) {
    String id = feed["id"].as<String>();

    if (id.isEmpty()) {
      String novoId = "esp32-" +
        String((unsigned long)esp_random(), HEX) +
        "-" +
        String((unsigned long)esp_random(), HEX);

      feed["id"] = novoId;
      alterado = true;

      Serial.print("ID atribuido: ");
      Serial.println(novoId);
    }
  }

  if (!alterado) {
    preferences.end();
    Serial.println("Todos os agendamentos ja possuem IDs.");
    return true;
  }

  String novoRegistro;
  serializeJson(doc, novoRegistro);

  if (novoRegistro.length() > 1900) {
    Serial.println("Erro: registro excede o limite.");
    preferences.end();
    return false;
  }

  size_t gravados = preferences.putString(
    "schedule_v2",
    novoRegistro
  );

  preferences.end();

  if (gravados != novoRegistro.length()) {
    Serial.println("Erro ao salvar IDs na NVS.");
    return false;
  }

  Serial.println("Migracao de IDs concluida!");
  return true;
}

void carregarAgendamentosDoFlash() {
  if (!migrarAgendamentosAntigos()) {
    Serial.println("Falha ao preparar armazenamento de agendamentos.");
    return;
  }

  if (!migrarIdsAgendamentos()) {
    Serial.println("Falha ao preparar IDs dos agendamentos.");
    return;
  }

  if (!preferences.begin("feeder", true)) {
    Serial.println("Erro ao abrir NVS para leitura.");
    return;
  }

  String registro = preferences.getString("schedule_v2", "");

  preferences.end();

  JsonDocument doc;

  DeserializationError erro = deserializeJson(doc, registro);

  if (erro || !doc.is<JsonObject>() ||
      !doc["feeds"].is<JsonArray>()) {
    Serial.println("Erro ao interpretar registro da NVS.");
    return;
  }

  revisionAtual = doc["revision"] | 0;
  ultimoRequestId = doc["requestId"].as<String>();

  String feedsJSON;
  serializeJson(doc["feeds"], feedsJSON);

  processarJSONAgendamentos(feedsJSON);

  Serial.println("Agendamentos recuperados do novo registro NVS.");

  Serial.printf(
    "Revisao atual: %lu\n",
    (unsigned long)revisionAtual
  );
}

void processarJSONAgendamentos(const String& jsonPayload) {
 StaticJsonDocument<2048> doc;
 DeserializationError error = deserializeJson(doc, jsonPayload);


 if (error) {
   Serial.print("Erro no JSON de agendamentos: ");
   Serial.println(error.c_str());
   return;
 }


 JsonArray array = doc.as<JsonArray>();
 scheduleCount = 0;


 for (JsonObject obj : array) {
   if (scheduleCount >= MAX_SCHEDULES) break;


   String timeStr = obj["time"] | "00:00";
   schedules[scheduleCount].hour = timeStr.substring(0, 2).toInt();
   schedules[scheduleCount].minute = timeStr.substring(3, 5).toInt();
   schedules[scheduleCount].duration = obj["portions"] | 5;
   schedules[scheduleCount].enabled = obj["enabled"] | true;


   String daysStr = obj["days"] | "";
  strncpy(
    schedules[scheduleCount].days,
    daysStr.c_str(),
    sizeof(schedules[scheduleCount].days) - 1
  );

schedules[scheduleCount].days[sizeof(schedules[scheduleCount].days) - 1] = '\0';


   scheduleCount++;
 }


 Serial.printf("Agendamentos carregados na memória RAM: %d\n", scheduleCount);
}

//CHECA HORARIO
void verificarAgendamentosLocais() {
 struct tm timeinfo;
 if (!getLocalTime(&timeinfo)) return;

 if (timeinfo.tm_min == lastCheckedMinute) return;
 lastCheckedMinute = timeinfo.tm_min;

 const char* wdayNames[] = {"sun", "mon", "tue", "wed", "thu", "fri", "sat"};
 String hojeNome = String(wdayNames[timeinfo.tm_wday]);


 for (int i = 0; i < scheduleCount; i++) {
   if (!schedules[i].enabled) continue;


   if (schedules[i].hour == timeinfo.tm_hour && schedules[i].minute == timeinfo.tm_min) {
     String diasStr = String(schedules[i].days);
     diasStr.toLowerCase(); // Garante tudo em minúsculo para evitar erros


     bool deveExecutar = false;
     if (diasStr.indexOf("todos os dias") != -1 || diasStr.indexOf(hojeNome) != -1) {
       deveExecutar = true;
     }


     if (deveExecutar) {
       Serial.printf("DISPARO AUTÔNOMO DE AGENDAMENTO: %02d:%02d!\n", schedules[i].hour, schedules[i].minute);
       acionarMotorPorSegundos(schedules[i].duration);
     }
   }
 }
}


void publicarAgendamentosDoFlash(const String& queryId) {
  if (!preferences.begin("feeder", true)) {
    Serial.println("Erro ao abrir NVS.");
    return;
  }

  String registro =
    preferences.getString("schedule_v2", "");

  preferences.end();

  JsonDocument doc;

  DeserializationError erro =
    deserializeJson(doc, registro);

  if (erro || !doc.is<JsonObject>() ||
      !doc["feeds"].is<JsonArray>() ||
      !doc["revision"].is<uint32_t>() ||
      !doc["requestId"].is<const char*>()) {
    Serial.println("Erro ao recuperar agendamentos.");
    return;
  }

  // Monta a resposta com os dados salvos na NVS
  JsonDocument resposta;

  resposta["revision"] =
    doc["revision"].as<uint32_t>();

  resposta["requestId"] =
    doc["requestId"].as<String>();

  resposta["queryId"] = queryId;

  resposta["feeds"] =
    doc["feeds"].as<JsonArray>();

  String respostaJSON;
  serializeJson(resposta, respostaJSON);

  Serial.println("Agendamentos recuperados da NVS:");
  Serial.println(respostaJSON);

  if (mqttClient.connected()) {
    bool enviado = mqttClient.publish(
      MQTT_TOPIC_RESPOSTA_AGENDAMENTOS,
      respostaJSON.c_str()
    );

    Serial.println(
      enviado
        ? "Resposta enviada ao aplicativo."
        : "Falha ao enviar resposta."
    );
  }
}
