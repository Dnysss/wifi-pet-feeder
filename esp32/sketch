//COMUNICACAO MQTT
void publicarStatus(const char* status) {
 if (mqttClient.connected()) {
   mqttClient.publish(MQTT_TOPIC_STATUS, status);
   Serial.print("Status enviado: ");
   Serial.println(status);
 }
}


void conectarMQTT() {
 //verifica se o wifi ta conectado
  if (WiFi.status() != WL_CONNECTED) {
    return;
  }

  //aguarda a sincronizacao da hora antes da tls
  time_t agora = time(nullptr);

  if (agora < 1700000000) {
    return;
  }

  //nao tenta conectar se ja tiver conectado
  if (mqttClient.connected()) {
    return;
  }

  unsigned long agora = millis();

  //aguarda o intervalo entre as tentativas
  if (!primeiraTentativaMQTT &&
      agora - ultimaTentativaMQTT < INTERVALO_MQTT) {
    return;
  }

  primeiraTentativaMQTT = false;
  ultimaTentativaMQTT = agora;

  Serial.println("\nConectando ao HiveMQ...");

  String clientId = "ESP32-Alimentador-" +
                    String((uint32_t)ESP.getEfuseMac(), HEX);

  if (mqttClient.connect(
        clientId.c_str(),
        MQTT_USERNAME,
        MQTT_PASSWORD,
        MQTT_TOPIC_PRESENCA,
        1,
        true,
        "offline"
      )) {

    Serial.println("================================");
    Serial.println("MQTT CONECTADO COM TLS!");
    Serial.println("================================");

    //informar se o esp ta online
    mqttClient.publish(MQTT_TOPIC_PRESENCA, "online", true);

    mqttClient.subscribe(MQTT_TOPIC_COMANDO);
    mqttClient.subscribe(MQTT_TOPIC_AGENDAMENTOS);
    mqttClient.subscribe(MQTT_TOPIC_SOLICITAR_AGENDAMENTOS);

    Serial.print("Inscrito em: ");
    Serial.println(MQTT_TOPIC_COMANDO);

    Serial.print("Inscrito em: ");
    Serial.println(MQTT_TOPIC_AGENDAMENTOS);

    Serial.print("Inscrito em: ");
    Serial.println(MQTT_TOPIC_SOLICITAR_AGENDAMENTOS);

    publicarStatus("online");

  } else {
    Serial.print("Falha MQTT, código: ");
    Serial.println(mqttClient.state());
    Serial.println("Tentando novamente em 5 segundos...");
  }
}

void publicarAckAgendamentos(
  const String& requestId,
  uint32_t revision,
  const char* status
) {
  JsonDocument doc;

  doc["requestId"] = requestId;
  doc["revision"] = revision;
  doc["status"] = status;

  String resposta;
  serializeJson(doc, resposta);

  if (!mqttClient.connected()) {
    Serial.println("Não foi possível publicar ACK: MQTT desconectado.");
    return;
  }

  bool enviado = mqttClient.publish(
    MQTT_TOPIC_ACK_AGENDAMENTOS,
    resposta.c_str()
  );

  if (enviado) {
    Serial.println("ACK publicado:");
    Serial.println(resposta);
  } else {
    Serial.println("Falha ao publicar ACK.");
  }
}

void mensagemRecebida(char* topic, byte* payload, unsigned int length) {
  String mensagem = "";

  for (unsigned int i = 0; i < length; i++) {
    mensagem += (char)payload[i];
  }

  mensagem.trim();

  String topicoRecebido = String(topic);

  Serial.println("\n================================");
  Serial.print("Topico: ");
  Serial.println(topicoRecebido);
  Serial.print("Conteudo: ");
  Serial.println(mensagem);
//TOPICO DE LISTA DE AGENDAMENTOS
  if (topicoRecebido == MQTT_TOPIC_COMANDO) {
    if (mensagem == "0") {
    motorLigado = false;
    motor.disableOutputs();
    publicarStatus("parado");
    } else {
      bool comandoValido =
        !mensagem.isEmpty() &&
        mensagem.length() <= 2;

      for (size_t i = 0; i < mensagem.length(); i++) {
        if (!isDigit(mensagem.charAt(i))) {
          comandoValido = false;
          break;
        }
      }

      int segundos = comandoValido ? mensagem.toInt() : 0;

      if (segundos >= 1 && segundos <= 60) {
        acionarMotorPorSegundos(segundos);
      } else {
        Serial.println("ERRO: Duracao manual invalida.");
        publicarStatus("erro_comando");
      }
    }
  }

  else if (topicoRecebido == MQTT_TOPIC_AGENDAMENTOS) {
    JsonDocument doc;

    DeserializationError erro = deserializeJson(doc, mensagem);

    if (erro || !doc.is<JsonObject>()) {
      Serial.println("ERRO: Formato MQTT invalido.");
      return;
    }

    if (!doc["requestId"].is<const char*>() ||
        !doc["revision"].is<uint32_t>() ||
        !doc["feeds"].is<JsonArray>()) {
      Serial.println("ERRO: Campos obrigatorios invalidos.");
      return;
    }

    String requestId = doc["requestId"].as<String>();
    uint32_t revision = doc["revision"].as<uint32_t>();

    if (requestId.isEmpty() || requestId.length() > 80) {
      Serial.println("ERRO: requestId invalido.");
      return;
    }

    String feedsJSON;
    serializeJson(doc["feeds"], feedsJSON);

    // Mesma operacao recebida novamente
    if (revision == revisionAtual &&
        requestId == ultimoRequestId) {
      Serial.println("Operacao ja salva. Reenviando ACK.");
      publicarAckAgendamentos(requestId, revision, "saved");
      return;
    }

    if (revisionAtual == UINT32_MAX) {
      Serial.println("ERRO: Limite maximo de revisoes atingido.");
      publicarAckAgendamentos(requestId, revision, "rejected");
      return;
    }
    
    // Somente a proxima revisao pode ser gravada
    if (revision <= revisionAtual ||
        revision != revisionAtual + 1) {
      Serial.println("ERRO: Revisao desatualizada ou inesperada.");
      publicarAckAgendamentos(requestId, revision, "rejected");
      publicarAgendamentosDoFlash();
      return;
    }

    if (!validarAgendamentos(feedsJSON)) {
      Serial.println("ERRO: Lista rejeitada.");
      publicarAckAgendamentos(requestId, revision, "rejected");
      return;
    }

    if (!salvarRegistroAgendamentos(
          requestId,
          revision,
          feedsJSON
        )) {
      Serial.println("ERRO: Falha ao salvar ou verificar registro na NVS.");
      return;
    }

    if (!carregarAgendamentosDoFlash()) {
      Serial.println("ERRO: Registro salvo, mas falha ao atualizar a RAM.");
      return;
    }

    publicarAckAgendamentos(requestId, revision, "saved");

    Serial.println("Agendamentos salvos e confirmados.");
  }

else if (topicoRecebido == MQTT_TOPIC_SOLICITAR_AGENDAMENTOS) {
  Serial.println("Solicitacao de agendamentos recebida.");

  JsonDocument pedido;

  DeserializationError erro =
    deserializeJson(pedido, mensagem);

  if (erro || !pedido.is<JsonObject>() ||
      !pedido["queryId"].is<const char*>()) {
    Serial.println("ERRO: Solicitacao invalida.");
    return;
  }

  String queryId = pedido["queryId"].as<String>();

  if (queryId.isEmpty() || queryId.length() > 80) {
    Serial.println("ERRO: queryId invalido.");
    return;
  }

  publicarAgendamentosDoFlash(queryId);
}

  Serial.println("================================");
}

//ACIONA O MOTOR
void acionarMotorPorSegundos(unsigned long segundos) {
  if (segundos < 1 || segundos > 60) {
    Serial.println("ERRO: Duracao do motor fora do limite.");
    publicarStatus("erro_comando");
    return;
  }
 tempoMotor = segundos * 1000UL;
 motorLigado = true;
 motor.enableOutputs();
 motor.setSpeed(velocidade);
 inicioMotor = millis();


 Serial.printf("Motor ligado por %lu segundos.\n", segundos);
 publicarStatus("alimentando");
}

//MEMORIA FLASH SINCRO AGENDAMENTOS
bool validarAgendamentos(const String& jsonPayload) {
  JsonDocument doc;

  DeserializationError error = deserializeJson(doc, jsonPayload);

  if (error || !doc.is<JsonArray>()) {
    Serial.println("ERRO: JSON de agendamentos invalido.");
    return false;
  }

  JsonArray array = doc.as<JsonArray>();

  if (array.size() > MAX_SCHEDULES) {
    Serial.println("ERRO: Limite de agendamentos excedido.");
    return false;
  }

  const char* diasValidos[] = {
    "mon", "tue", "wed", "thu", "fri", "sat", "sun"
  };

  for (JsonVariant item : array) {
    if (!item.is<JsonObject>()) {
      Serial.println("ERRO: Agendamento nao e um objeto.");
      return false;
    }

    JsonObject obj = item.as<JsonObject>();

    // Validar campos obrigatorios
    if (!obj["id"].is<const char*>() ||
        !obj["time"].is<const char*>() ||
        !obj["portions"].is<int>() ||
        !obj["enabled"].is<bool>() ||
        !obj["days"].is<JsonArray>()) {
      Serial.println("ERRO: Campos ausentes ou invalidos.");
      return false;
    }

    String id = obj["id"].as<String>();
    String horario = obj["time"].as<String>();
    int duracao = obj["portions"].as<int>();

    if (id.isEmpty() || id.length() >= 80) {
      Serial.println("ERRO: ID invalido.");
      return false;
    }

    if (horario.length() != 5 ||
        horario.charAt(2) != ':' ||
        !isDigit(horario.charAt(0)) ||
        !isDigit(horario.charAt(1)) ||
        !isDigit(horario.charAt(3)) ||
        !isDigit(horario.charAt(4))) {
      Serial.println("ERRO: Horario invalido.");
      return false;
    }

    int hora = horario.substring(0, 2).toInt();
    int minuto = horario.substring(3, 5).toInt();

    if (hora > 23 || minuto > 59 ||
        duracao < 1 || duracao > 60) {
      Serial.println("ERRO: Horario ou duracao fora do limite.");
      return false;
    }

    // Validar array de dias
    JsonArray dias = obj["days"].as<JsonArray>();

    if (dias.size() < 1 || dias.size() > 7) {
      Serial.println("ERRO: Quantidade de dias invalida.");
      return false;
    }

    bool diasEncontrados[7] = {false, false, false, false, false, false, false};

    for (JsonVariant diaAtual : dias) {
      if (!diaAtual.is<const char*>()) {
        Serial.println("ERRO: Dia deve ser uma string.");
        return false;
      }

      const char* dia = diaAtual.as<const char*>();

      int indiceDia = -1;

      for (int i = 0; i < 7; i++) {
        if (strcmp(dia, diasValidos[i]) == 0) {
          indiceDia = i;
          break;
        }
      }

      if (indiceDia == -1) {
        Serial.print("ERRO: Dia invalido: ");
        Serial.println(dia);
        return false;
      }

      if (diasEncontrados[indiceDia]) {
        Serial.println("ERRO: Dia repetido no agendamento.");
        return false;
      }

      diasEncontrados[indiceDia] = true;
    }
  }

  for (size_t i = 0; i < array.size(); i++) {
    if (i == 0) break;

    for (size_t j = 0; j < i; j++) {
      JsonObject atual = array[i].as<JsonObject>();
      JsonObject anterior = array[j].as<JsonObject>();

      if (atual["id"].as<String>() == anterior["id"].as<String>()) {
        Serial.println("ERRO: ID duplicado.");
        return false;
      }
    }
  }

  return true;
}

bool migrarAgendamentosAntigos() {
  if (!preferences.begin("feeder", false)) {
    Serial.println("Erro ao abrir NVS para migracao.");
    return false;
  }

  //novo registro ja existe nao migrar novamente
  if (preferences.isKey("schedule_v2")) {
    preferences.end();
    return true;
  }

  String jsonAntigo = preferences.getString("schedules", "[]");

  JsonDocument antigo;

  DeserializationError erro = deserializeJson(antigo, jsonAntigo);

  if (erro || !antigo.is<JsonArray>()) {
    Serial.println("Erro: agendamentos antigos invalidos.");
    preferences.end();
    return false;
  }

  JsonDocument novo;

  novo["revision"] = 0;
  novo["requestId"] = "";

  novo["feeds"] = antigo.as<JsonArray>();

  String registro;
  serializeJson(novo, registro);

  size_t gravados = preferences.putString("schedule_v2", registro);

  preferences.end();

  if (gravados != registro.length()) {
    Serial.println("Erro ao migrar agendamentos.");
    return false;
  }

  Serial.println("Agendamentos antigos migrados com sucesso!");
  return true;
}


bool salvarRegistroAgendamentos(
  const String& requestId,
  uint32_t revision,
  const String& feedsJSON
) {

  if (requestId.length() == 0 || revision == 0) {
    Serial.println("Erro: requestId ou revision invalido.");
    return false;
  }

  if (revisionAtual == UINT32_MAX ||
    revision != revisionAtual + 1) {
    Serial.println("Erro: revisao inesperada.");
    return false;
  }

  JsonDocument feedsDoc;

  DeserializationError erro = deserializeJson(feedsDoc, feedsJSON);

  if (erro || !feedsDoc.is<JsonArray>()) {
    Serial.println("Erro: lista de agendamentos invalida.");
    return false;
  }

  if (feedsDoc.as<JsonArray>().size() > MAX_SCHEDULES) {
    Serial.println("Erro: limite de agendamentos excedido.");
    return false;
  }

  JsonDocument registroDoc;

  registroDoc["revision"] = revision;
  registroDoc["requestId"] = requestId;
  registroDoc["feeds"] = feedsDoc.as<JsonArray>();

  String registroJSON;
  serializeJson(registroDoc, registroJSON);

  if (!preferences.begin("feeder", false)) {
    Serial.println("Erro ao abrir NVS.");
    return false;
  }

  if (registroJSON.length() > 1900) {
    Serial.println("ERRO: Registro excede o limite configurado.");
    preferences.end();
    return false;
  }

  size_t gravados = preferences.putString(
    "schedule_v2",
    registroJSON
  );

  preferences.end();

  if (gravados != registroJSON.length()) {
    Serial.println("Erro ao gravar registro na NVS.");
    return false;
  }

  //confirma que o registro pode ser lid novamente
  if (!preferences.begin("feeder", true)) {
    return false;
  }

  String registroLido = preferences.getString("schedule_v2", "");

  preferences.end();

  if (registroLido != registroJSON) {
    Serial.println("Erro: verificacao da gravacao falhou.");
    return false;
  }

  Serial.printf(
    "Registro salvo na NVS! Revisao: %lu\n",
    (unsigned long)revision
  );

  return true;
}

bool migrarIdsAgendamentos() {
  if (!preferences.begin("feeder", false)) {
    Serial.println("Erro ao abrir NVS para migrar IDs.");
    return false;
  }

  String registro = preferences.getString("schedule_v2", "");

  JsonDocument doc;

  DeserializationError erro = deserializeJson(doc, registro);

  if (erro || !doc.is<JsonObject>() ||
      !doc["feeds"].is<JsonArray>()) {
    Serial.println("Erro ao interpretar agendamentos para migracao.");
    preferences.end();
    return false;
  }

  JsonArray feeds = doc["feeds"].as<JsonArray>();
  bool alterado = false;

  for (JsonObject feed : feeds) {
    String id = feed["id"].as<String>();

    if (id.isEmpty()) {
      String novoId = "esp32-" +
        String((unsigned long)esp_random(), HEX) +
        "-" +
        String((unsigned long)esp_random(), HEX);

      feed["id"] = novoId;
      alterado = true;

      Serial.print("ID atribuido: ");
      Serial.println(novoId);
    }
  }

  if (!alterado) {
    preferences.end();
    Serial.println("Todos os agendamentos ja possuem IDs.");
    return true;
  }

  String novoRegistro;
  serializeJson(doc, novoRegistro);

  if (novoRegistro.length() > 1900) {
    Serial.println("Erro: registro excede o limite.");
    preferences.end();
    return false;
  }

  size_t gravados = preferences.putString(
    "schedule_v2",
    novoRegistro
  );

  preferences.end();

  if (gravados != novoRegistro.length()) {
    Serial.println("Erro ao salvar IDs na NVS.");
    return false;
  }

  Serial.println("Migracao de IDs concluida!");
  return true;
}

bool carregarAgendamentosDoFlash() {
  if (!migrarAgendamentosAntigos()) {
    Serial.println("Falha ao preparar armazenamento de agendamentos.");
    return false;
  }

  if (!migrarIdsAgendamentos()) {
    Serial.println("Falha ao preparar IDs dos agendamentos.");
    return false;
  }

  if (!preferences.begin("feeder", true)) {
    Serial.println("Erro ao abrir NVS para leitura.");
    return false;
  }

  String registro = preferences.getString("schedule_v2", "");
  preferences.end();

  JsonDocument doc;

  DeserializationError erro = deserializeJson(doc, registro);

  if (
    erro ||
    !doc.is<JsonObject>() ||
    !doc["feeds"].is<JsonArray>() ||
    !doc["revision"].is<uint32_t>() ||
    !doc["requestId"].is<const char*>() ||
    (
      doc["revision"].as<uint32_t>() > 0 &&
      strlen(doc["requestId"].as<const char*>()) == 0
    )
  ) {
    Serial.println("Erro ao interpretar registro da NVS.");
    return false;
  }

  uint32_t novaRevision = doc["revision"].as<uint32_t>();
  String novoRequestId = doc["requestId"].as<String>();

  String feedsJSON;
  serializeJson(doc["feeds"], feedsJSON);

  if (!processarJSONAgendamentos(feedsJSON)) {
    Serial.println("Falha ao processar agendamentos da NVS.");
    return false;
  }

  revisionAtual = novaRevision;
  ultimoRequestId = novoRequestId;

  Serial.println("Agendamentos recuperados do novo registro NVS.");

  Serial.printf(
    "Revisao atual: %lu\n",
    (unsigned long)revisionAtual
  );

  return true;
}

bool processarJSONAgendamentos(const String& jsonPayload) {
  // Valida todos os dados antes de alterar a RAM
  if (!validarAgendamentos(jsonPayload)) {
    Serial.println("ERRO: Agendamentos invalidos para processamento.");
    return false;
  }

  JsonDocument doc;

  DeserializationError erro = deserializeJson(doc, jsonPayload);

  if (erro || !doc.is<JsonArray>()) {
    Serial.println("Erro no JSON de agendamentos.");
    return false;
  }

  JsonArray array = doc.as<JsonArray>();

  // Armazenamento temporário: evita atualização parcial da RAM
  FeedSchedule temporarios[MAX_SCHEDULES];

  int quantidade = array.size();

  for (int i = 0; i < quantidade; i++) {
    JsonObject obj = array[i].as<JsonObject>();

    FeedSchedule& schedule = temporarios[i];

    String id = obj["id"].as<String>();

    strncpy(
      schedule.id,
      id.c_str(),
      sizeof(schedule.id) - 1
    );

    schedule.id[sizeof(schedule.id) - 1] = '\0';

    String horario = obj["time"].as<String>();

    schedule.hour = horario.substring(0, 2).toInt();
    schedule.minute = horario.substring(3, 5).toInt();

    schedule.duration = obj["portions"].as<int>();
    schedule.enabled = obj["enabled"].as<bool>();

    JsonArray daysArray = obj["days"].as<JsonArray>();

    schedule.daysCount = 0;

    for (JsonVariant dia : daysArray) {
      const char* nomeDia = dia.as<const char*>();

      strncpy(
        schedule.days[schedule.daysCount],
        nomeDia,
        sizeof(schedule.days[schedule.daysCount]) - 1
      );

      schedule.days[schedule.daysCount]
        [sizeof(schedule.days[schedule.daysCount]) - 1] = '\0';

      schedule.daysCount++;
    }
  }

  // Somente agora atualiza a lista global
  for (int i = 0; i < quantidade; i++) {
    schedules[i] = temporarios[i];
  }

  scheduleCount = quantidade;

  Serial.printf(
    "Agendamentos carregados na memoria RAM: %d\n",
    scheduleCount
  );

  Serial.println("================================");
  Serial.println("      LISTA DE AGENDAMENTOS");
  Serial.println("================================");

  for (int i = 0; i < scheduleCount; i++) {
    Serial.printf(
      "%d. ID: %s\n",
      i + 1,
      schedules[i].id
    );

    Serial.printf(
      "   Horario: %02d:%02d\n",
      schedules[i].hour,
      schedules[i].minute
    );

    Serial.print("   Dias: ");

    for (int j = 0; j < schedules[i].daysCount; j++) {
      Serial.print(schedules[i].days[j]);

      if (j < schedules[i].daysCount - 1) {
        Serial.print(", ");
      }
    }

    Serial.println();

    Serial.printf(
      "   Duracao: %d segundos\n",
      schedules[i].duration
    );

    Serial.print("   Status: ");
    Serial.println(
      schedules[i].enabled ? "ATIVO" : "DESATIVADO"
    );

    Serial.println("--------------------------------");
  }

  Serial.printf(
    "Total de agendamentos: %d/%d\n",
    scheduleCount,
    MAX_SCHEDULES
  );

  Serial.println("================================");

  return true;
}

//CHECA HORARIO
void verificarAgendamentosLocais() {
  time_t agora = time(nullptr);

  if (agora < 1700000000) {
    return;
  }

  struct tm timeinfo;

  if (localtime_r(&agora, &timeinfo) == nullptr) {
    return;
  }

  static int ultimoMinutoVerificado = -1;

  int minutoAtual = timeinfo.tm_hour * 60 + timeinfo.tm_min;

  if (minutoAtual == ultimoMinutoVerificado) {
    return;
  }

  ultimoMinutoVerificado = minutoAtual;

  const char* wdayNames[] = {
    "sun", "mon", "tue", "wed", "thu", "fri", "sat"
  };

  const char* hojeNome = wdayNames[timeinfo.tm_wday];

  for (int i = 0; i < scheduleCount; i++) {
    if (!schedules[i].enabled) continue;

    if (schedules[i].hour == timeinfo.tm_hour &&
        schedules[i].minute == timeinfo.tm_min) {

      bool deveExecutar = false;

      //verifica se o dia atual ta no array
      for (int j = 0; j < schedules[i].daysCount; j++) {
        if (strcmp(schedules[i].days[j], hojeNome) == 0) {
          deveExecutar = true;
          break;
        }
      }

      if (deveExecutar) {
        Serial.println("================================");
        Serial.println("DISPARO AUTONOMO DE AGENDAMENTO!");

        Serial.print("ID: ");
        Serial.println(schedules[i].id);

        Serial.printf(
          "Horario: %02d:%02d\n",
          schedules[i].hour,
          schedules[i].minute
        );

        Serial.printf(
          "Duracao: %d segundos\n",
          schedules[i].duration
        );

        Serial.println("================================");

        acionarMotorPorSegundos(schedules[i].duration);
      }
    }
  }
}

void publicarAgendamentosDoFlash(const String& queryId) {
  if (!carregarAgendamentosDoFlash()) {
    Serial.println("Falha ao atualizar a RAM antes de responder ao aplicativo.");
    return;
  }

  if (!preferences.begin("feeder", true)) {
    Serial.println("Erro ao abrir NVS.");
    return;
  }

  String registro = preferences.getString("schedule_v2", "");

  preferences.end();

  JsonDocument doc;

  DeserializationError erro = deserializeJson(doc, registro);

  if (
    erro ||
    !doc.is<JsonObject>() ||
    !doc["feeds"].is<JsonArray>() ||
    !doc["revision"].is<uint32_t>() ||
    !doc["requestId"].is<const char*>() ||
    (
      doc["revision"].as<uint32_t>() > 0 &&
      strlen(doc["requestId"].as<const char*>()) == 0
    )
  ) {
    Serial.println("Erro ao recuperar agendamentos.");
    return;
  }

  //valida os agendamentos recuperados na nvs
  String feedsJSON;
  serializeJson(doc["feeds"], feedsJSON);

  if (!validarAgendamentos(feedsJSON)) {
    Serial.println("ERRO: Agendamentos armazenados na NVS sao invalidos.");
    return;
  }

  //motna a resposta com os dados salvos na nvs
  JsonDocument resposta;

  resposta["revision"] = doc["revision"].as<uint32_t>();
  resposta["requestId"] = doc["requestId"].as<String>();
  resposta["queryId"] = queryId;
  resposta["feeds"] = doc["feeds"].as<JsonArray>();

  String respostaJSON;
  serializeJson(resposta, respostaJSON);

  Serial.println("Agendamentos recuperados da NVS:");
  Serial.println(respostaJSON);

  if (mqttClient.connected()) {
    bool enviado = mqttClient.publish(
      MQTT_TOPIC_RESPOSTA_AGENDAMENTOS,
      respostaJSON.c_str()
    );

    Serial.println(
      enviado
        ? "Resposta enviada ao aplicativo."
        : "Falha ao enviar resposta."
    );
  } else {
    Serial.println("MQTT desconectado. Resposta nao enviada.");
  }
}
