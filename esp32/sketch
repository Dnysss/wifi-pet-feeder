void acionarMotorPorSegundos(unsigned long segundos) {
 tempoMotor = segundos * 1000UL;
 motorLigado = true;
 motor.enableOutputs();
 motor.setSpeed(velocidade);
 inicioMotor = millis();


 Serial.printf("Motor ligado por %lu segundos.\n", segundos);
